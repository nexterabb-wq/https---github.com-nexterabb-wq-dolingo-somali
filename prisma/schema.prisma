generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// Content Status Enum
// ============================================================

enum ContentStatus {
  draft
  pending_review
  published
}

// ============================================================
// User & Auth
// ============================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  image         String?
  preferredLang String    @default("so") // default Somali
  role          String    @default("learner") // learner, reviewer, admin, linguist
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  progress       UserProgress[]
  dailyStreaks   DailyStreak[]
  achievements  UserAchievement[]
  bookmarks     Bookmark[]
  statistics    UserStatistic[]
  accounts      Account[]
  sessions      Session[]
  xpTransactions XpTransaction[]
  coinTransactions CoinTransaction[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================
// Content Hierarchy: Course -> Unit -> Lesson -> Section
// ============================================================

model Course {
  id          String        @id @default(cuid())
  title       String
  description String?
  coverImage  String?
  language    String        @default("en") // target language
  sourceLang  String        @default("so") // learner's language
  difficulty  String        @default("beginner")
  sortOrder   Int           @default(0)
  status      ContentStatus @default(draft)
  contentSource String     @default("human") // human, ai, linguist
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  units       Unit[]
}

model Unit {
  id          String        @id @default(cuid())
  courseId    String
  title       String
  description String?
  coverImage  String?
  sortOrder   Int           @default(0)
  status      ContentStatus @default(draft)
  contentSource String     @default("human")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  course      Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]

  @@index([courseId])
}

model Lesson {
  id          String        @id @default(cuid())
  unitId      String
  title       String
  description String?
  type        String        @default("lesson") // lesson, quiz, review
  xpReward    Int           @default(10)
  sortOrder   Int           @default(0)
  status      ContentStatus @default(draft)
  contentSource String     @default("human")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  unit        Unit          @relation(fields: [unitId], references: [id], onDelete: Cascade)
  sections    Section[]

  @@index([unitId])
}

model Section {
  id          String        @id @default(cuid())
  lessonId    String
  title       String?
  type        String        @default("vocabulary") // vocabulary, grammar, exercise, quiz, review
  sortOrder   Int           @default(0)
  status      ContentStatus @default(draft)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  lesson      Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  vocabulary  Vocabulary[]
  exercises   Exercise[]

  @@index([lessonId])
}

// ============================================================
// Vocabulary
// ============================================================

model Vocabulary {
  id                String        @id @default(cuid())
  sectionId         String
  english           String
  somali            String
  pronunciationGuide String?
  partOfSpeech      String?       // noun, verb, adjective, etc.
  difficulty        String        @default("beginner")
  exampleSentence   String?
  exampleTranslation String?
  grammarNotes      String?
  tags              String        @default("[]") // JSON array stored as string
  imageUrl          String?
  audioUrl          String?
  voiceType         String?       // native, tts, ai
  audioDuration     Int?          // seconds
  audioProvider     String?
  status            ContentStatus @default(draft)
  contentSource     String        @default("human")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  section           Section       @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
  @@index([status])
}

// ============================================================
// Exercises - polymorphic via exerciseType
// ============================================================

enum ExerciseType {
  multiple_choice
  match_word
  fill_blank
  listening
  speaking
  typing
  sentence_ordering
  translation
  image_selection
}

model Exercise {
  id          String        @id @default(cuid())
  sectionId   String
  exerciseType ExerciseType
  // JSON blob: type-specific config (question, options, correctAnswer, etc.)
  config      String        // JSON string - flexible for all exercise types
  xpReward    Int           @default(5)
  sortOrder   Int           @default(0)
  status      ContentStatus @default(draft)
  contentSource String     @default("human")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  section     Section       @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
  @@index([exerciseType])
}

// ============================================================
// Progress Tracking
// ============================================================

model UserProgress {
  id            String   @id @default(cuid())
  userId        String
  lessonId      String
  completed     Boolean  @default(false)
  score         Int?     // percentage 0-100
  attempts      Int      @default(0)
  bestScore     Int?
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
}

// ============================================================
// Gamification: XP, Levels, Hearts, Coins, Streaks, Achievements
// ============================================================

model XpTransaction {
  id          String   @id @default(cuid())
  userId      String
  amount      Int      // positive = earned, negative = spent
  source      String   // lesson_complete, exercise_correct, streak_bonus, achievement, etc.
  sourceId    String?  // reference to lesson/exercise/achievement id
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CoinTransaction {
  id          String   @id @default(cuid())
  userId      String
  amount      Int      // positive = earned, negative = spent
  source      String   // lesson_complete, streak_bonus, purchase, etc.
  sourceId    String?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Level {
  id        String  @id @default(cuid())
  level     Int     @unique
  title     String
  xpRequired Int    // total XP needed to reach this level
  icon      String?
}

model Achievement {
  id          String  @id @default(cuid())
  key         String  @unique  // e.g. "first_lesson", "week_streak", "vocab_master"
  title       String
  description String
  icon        String?
  xpReward    Int     @default(0)
  coinReward  Int     @default(0)
  category    String? // learning, streak, social, mastery

  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  awardedAt     DateTime @default(now())

  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id])

  @@unique([userId, achievementId])
  @@index([userId])
}

model Hearts {
  id        String   @id @default(cuid())
  userId    String   @unique
  current   Int      @default(5)
  maxHearts Int      @default(5)
  lastRefillAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Coins {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt
}

model DailyStreak {
  id            String   @id @default(cuid())
  userId        String
  currentStreak Int      @default(0)
  longestStreak Int      @default(0)
  lastActiveAt  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
}

// ============================================================
// Bookmarks
// ============================================================

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  vocabularyId String?
  lessonId  String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================================
// Statistics
// ============================================================

model UserStatistic {
  id          String   @id @default(cuid())
  userId      String
  date        String   // YYYY-MM-DD
  lessonsCompleted Int  @default(0)
  exercisesCompleted Int @default(0)
  xpEarned    Int      @default(0)
  timeSpentSeconds Int  @default(0)
  accuracy    Float?   // percentage
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}
